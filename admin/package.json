{
  "name": "pmman-admin",
  "private": true,
  "version": "0.0.1-alpha",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "dev": "vite --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src vite.config.ts --max-warnings=0",
    "format:check": "prettier --check src vite.config.ts eslint.config.js",
    "build": "pnpm format:check && pnpm lint && pnpm typecheck && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "axios": "^1.12.2",
    "element-plus": "^2.11.5",
    "pinia": "^3.0.3",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^22.18.6",
    "@vitejs/plugin-vue": "^6.0.7",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.5.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript-eslint": "^8.46.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vue-tsc": "^3.3.5"
  }
}
